#: src/ui/bk-settings.c:238 src/ui/bk-settings.c:1074
msgid "General"
msgstr "Geral"

#: src/ui/bk-settings.c:238
msgid ""
"Big WM Virtual Keyboard stays resident and quiet (using no CPU) so that the "
"dockapp, the controller and the shortcut open the keyboard instantly."
msgstr ""
"O Big WM Virtual Keyboard fica residente e quieto (sem consumir CPU) para o "
"dockapp, o controle e o atalho abrirem o teclado na hora."

#: src/ui/bk-settings.c:244
msgid "Start with the session"
msgstr "Iniciar com a sessão"

#: src/ui/bk-settings.c:245
msgid "Follow Big WindowMaker"
msgstr "Acompanhar o Big WindowMaker"

#: src/ui/bk-settings.c:245
msgid "Light (OPENSTEP)"
msgstr "Claro (OPENSTEP)"

#: src/ui/bk-settings.c:246
msgid "Dark"
msgstr "Escuro"

#: src/ui/bk-settings.c:247
msgid "Theme"
msgstr "Tema"

#: src/ui/bk-settings.c:248
msgid "Independent (keyboard and gamepad together)"
msgstr "Independente (teclado e controle juntos)"

#: src/ui/bk-settings.c:249
msgid "Exclusive (opening one hides the other)"
msgstr "Exclusivo (abrir um oculta o outro)"

#: src/ui/bk-settings.c:250
msgid "Display mode"
msgstr "Modo de exibição"

#: src/ui/bk-settings.c:250
msgid "Applies to the dockapp buttons, the menu and the command line"
msgstr "Vale para os botões do dockapp, o menu e a linha de comando"

#: src/ui/bk-settings.c:252
msgid "Key size"
msgstr "Tamanho das teclas"

#: src/ui/bk-settings.c:252
msgid "Larger keys help with touch and accessibility"
msgstr "Teclas maiores ajudam no toque e na acessibilidade"

#: src/ui/bk-settings.c:254
msgid "Needs a compositor (picom on X11; wlmaker on Wayland)"
msgstr "Precisa de um compositor (picom no X11; o wlmaker no Wayland)"

#: src/ui/bk-settings.c:256
msgid ""
"<small>Language: the system one (LANG). Screen scale: the monitor's, "
"automatic.</small>"
msgstr ""
"<small>Idioma: o do sistema (LANG). Escala de tela: a do monitor, automática."
"</small>"

#: src/ui/bk-settings.c:275 src/ui/bk-settings.c:1074
msgid "Keyboard"
msgstr "Teclado"

#: src/ui/bk-settings.c:275
msgid ""
"Click, tap or use the controller. Modifiers (Shift, Ctrl, Alt, AltGr, "
"Super): one tap applies to the next key, two taps lock it (green LED), the "
"third releases it. Fn shows F1–F12 and navigation; ☺ shows symbols and "
"emojis."
msgstr ""
"Clique, toque ou use o controle. Modificadores (Shift, Ctrl, Alt, AltGr, "
"Super): um toque vale para a próxima tecla, dois toques travam (LED verde), "
"o terceiro solta. Fn mostra F1–F12 e navegação; ☺ mostra símbolos e emojis."

#: src/ui/bk-settings.c:278
msgid "System layout"
msgstr "O do sistema"

#: src/ui/bk-settings.c:278
msgid "Portuguese (ABNT2)"
msgstr "Português (ABNT2)"

#: src/ui/bk-settings.c:278
msgid "English (US)"
msgstr "Inglês (US)"

#: src/ui/bk-settings.c:279
msgid "English (US international)"
msgstr "Inglês (US internacional)"

#: src/ui/bk-settings.c:280 src/ui/bk-settings.c:834
msgid "Layout"
msgstr "Layout"

#: src/ui/bk-settings.c:281
msgid "Floating window, with a frame (move and resize)"
msgstr "Janela flutuante, com moldura (mover e redimensionar)"

#: src/ui/bk-settings.c:282
msgid "Docked at the bottom, full screen width (like on a phone)"
msgstr "Encaixado embaixo, na largura da tela (como no celular)"

#: src/ui/bk-settings.c:283
msgid "Window"
msgstr "Janela"

#: src/ui/bk-settings.c:283
msgid ""
"Floating: drag it by the title and resize it by the bottom edge; the "
"position and size are saved. Docked: takes the bottom of the whole screen."
msgstr ""
"Flutuante: arraste pelo título e redimensione pela borda de baixo; o lugar e "
"o tamanho ficam gravados. Encaixado: ocupa a parte de baixo da tela inteira."

#: src/ui/bk-settings.c:286
msgid "Like the other windows"
msgstr "Como as outras janelas"

#: src/ui/bk-settings.c:287
msgid "Above windows (recommended)"
msgstr "Por cima das janelas (recomendado)"

#: src/ui/bk-settings.c:288
msgid "Above everything, even games, videos and full-screen presentations"
msgstr "Por cima de tudo, até de jogos, vídeos e apresentações em tela cheia"

#: src/ui/bk-settings.c:290
msgid "Stay on top"
msgstr "Ficar por cima"

#: src/ui/bk-settings.c:290
msgid "On Wayland the keyboard always stays above regular windows"
msgstr "No Wayland o teclado sempre fica por cima das janelas comuns"

#: src/ui/bk-settings.c:292
msgid "Open when tapping a text field"
msgstr "Abrir ao tocar num campo de texto"

#: src/ui/bk-settings.c:292
msgid ""
"Like on a phone: the keyboard appears when a field you type in gets the "
"focus (through accessibility, AT-SPI)"
msgstr ""
"Como no celular: o teclado aparece quando um campo onde se digita ganha o "
"foco (pela acessibilidade, AT-SPI)"

#: src/ui/bk-settings.c:295
msgid "Close when leaving the text field"
msgstr "Fechar ao sair do campo de texto"

#: src/ui/bk-settings.c:295
msgid "Only when it opened by itself"
msgstr "Só quando ele abriu sozinho"

#: src/ui/bk-settings.c:296
msgid "Reserve the keyboard space"
msgstr "Reservar o espaço do teclado"

#: src/ui/bk-settings.c:296
msgid "Docked: windows move up so the keyboard does not cover the text field"
msgstr "Encaixado: as janelas sobem para o teclado não cobrir o campo de texto"

#: src/ui/bk-settings.c:298
msgid "Close after Enter"
msgstr "Fechar depois do Enter"

#: src/ui/bk-settings.c:299
msgid "Repeat delay (ms)"
msgstr "Atraso da repetição (ms)"

#: src/ui/bk-settings.c:299
msgid "Holding a key repeats it after this time"
msgstr "Segurar uma tecla repete depois deste tempo"

#: src/ui/bk-settings.c:301
msgid "Repeat interval (ms)"
msgstr "Intervalo da repetição (ms)"

#: src/ui/bk-settings.c:302
msgid "_Restore the window position and size"
msgstr "_Restaurar o lugar e o tamanho da janela"

#: src/ui/bk-settings.c:303
msgid ""
"<small>Applications that expose accessibility (GTK, Qt, Firefox, Chromium, "
"LibreOffice) report when a text field gets the focus. The key size (in "
"General) applies again when it is changed.</small>"
msgstr ""
"<small>Aplicativos que expõem a acessibilidade (GTK, Qt, Firefox, Chromium, "
"LibreOffice) avisam quando um campo de texto ganha o foco. O tamanho das "
"teclas (em Geral) volta a valer ao ser mudado.</small>"

#: src/ui/bk-settings.c:321
msgid ""
"No controller connected. Connect one via USB or Bluetooth; it shows up here "
"right away."
msgstr ""
"Nenhum controle ligado. Conecte por USB ou Bluetooth; ele aparece aqui na "
"hora."

#: src/ui/bk-settings.c:373 src/ui/bk-settings.c:1075
msgid "Physical controller"
msgstr "Controle físico"

#: src/ui/bk-settings.c:374
msgid ""
"D-pad: cursor from key to key. Sticks (point mode, like the SteamOS "
"keyboard): the left one points on the left half (blue cursor) and the right "
"one on the right half (orange); LT and RT press the key on each side."
msgstr ""
"Direcional: cursor de tecla em tecla. Analógicos (modo apontar, como o "
"teclado do SteamOS): o esquerdo aponta na metade esquerda (cursor azul) e o "
"direito na direita (laranja); LT e RT apertam a tecla de cada lado."

#: src/ui/bk-settings.c:377
msgid "Use the controller on the keyboard"
msgstr "Usar o controle no teclado"

#: src/ui/bk-settings.c:378
msgid "Select + Start opens the keyboard"
msgstr "Select + Start abre o teclado"

#: src/ui/bk-settings.c:378
msgid "From anywhere, even with the keyboard closed"
msgstr "De qualquer lugar, mesmo com o teclado fechado"

#: src/ui/bk-settings.c:380
msgid "D-pad and sticks (recommended)"
msgstr "Direcional e analógicos (recomendado)"

#: src/ui/bk-settings.c:381
msgid "Cursor only (D-pad and left stick)"
msgstr "Só cursor (direcional e analógico esquerdo)"

#: src/ui/bk-settings.c:382
msgid "Pointing with the sticks only"
msgstr "Só apontar com os analógicos"

#: src/ui/bk-settings.c:383
msgid "Navigation"
msgstr "Navegação"

#: src/ui/bk-settings.c:384
msgid "Stick dead zone"
msgstr "Zona morta dos analógicos"

#: src/ui/bk-settings.c:390
msgid "Tester: move the sticks and the triggers"
msgstr "Testador: mexa os analógicos e os gatilhos"

#: src/ui/bk-settings.c:392
msgid ""
"<b>Buttons on the keyboard</b>\n"
"A ✕: press the key · B ○: close · X □: delete · Y △: space\n"
"LB L1: Shift · RB R1: next panel (letters, Fn, symbols) · LT/RT: Shift/AltGr "
"(or press, in point mode)\n"
"Start: Enter · Select: switch the layout · L3: Caps · R3: Tab · "
"Select+Start: open/close"
msgstr ""
"<b>Botões no teclado</b>\n"
"A ✕: apertar a tecla · B ○: fechar · X □: apagar · Y △: espaço\n"
"LB L1: Shift · RB R1: próximo painel (letras, Fn, símbolos) · LT/RT: Shift/"
"AltGr (ou apertar, no modo apontar)\n"
"Start: Enter · Select: trocar o layout · L3: Caps · R3: Tab · Select+Start: "
"abrir/fechar"

#: src/ui/bk-settings.c:458 src/ui/bk-settings.c:530 src/ui/bk-settings.c:560
msgid "_Cancel"
msgstr "_Cancelar"

#: src/ui/bk-settings.c:459
msgid "_OK"
msgstr "_OK"

#: src/ui/bk-settings.c:488
#, c-format
msgid "%s (copy)"
msgstr "%s (cópia)"

#: src/ui/bk-settings.c:489
msgid "Duplicate layout"
msgstr "Duplicar layout"

#: src/ui/bk-settings.c:512
#, c-format
msgid "Delete the layout “%s”?"
msgstr "Excluir o layout “%s”?"

#: src/ui/bk-settings.c:529
msgid "Import layout"
msgstr "Importar layout"

#: src/ui/bk-settings.c:530
msgid "_Import"
msgstr "_Importar"

#: src/ui/bk-settings.c:543
#, c-format
msgid "Invalid layout: %s"
msgstr "Layout inválido: %s"

#: src/ui/bk-settings.c:559
msgid "Export layout"
msgstr "Exportar layout"

#: src/ui/bk-settings.c:560
