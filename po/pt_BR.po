#: src/ui/bk-settings.c:893
msgid ""
"The virtual controller (uinput) is created when the on-screen gamepad opens "
"and goes away when it closes: games (native, Steam/Proton, Wine, browsers) "
"see it as a regular gamepad."
msgstr ""
"O controle virtual (uinput) é criado ao abrir o controle na tela e some ao "
"fechá-lo: os jogos (nativos, Steam/Proton, Wine, navegadores) o veem como um "
"gamepad comum."

#: src/ui/bk-settings.c:895
msgid "Big WM Virtual Gamepad (recommended)"
msgstr "Big WM Virtual Gamepad (recomendado)"

#: src/ui/bk-settings.c:896
msgid "Xbox 360 compatible (only for games that require it)"
msgstr "Compatível com Xbox 360 (só para jogos que exigem)"

#: src/ui/bk-settings.c:897
