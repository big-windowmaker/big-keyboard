# Maintainer: Rafael Ruscher <rruscher@gmail.com>
# Big WindowMaker: https://github.com/big-windowmaker
#
# Big WM Virtual Keyboard: teclado na tela (ABNT2, US, US internacional),
# digitação pelo controle físico (estilo SteamOS), controle na tela de toque
# com controle virtual (uinput) e o dockapp de dois botões (Enter ↵ e
# direcional). Um botão troca o teclado pelo controle na tela e vice-versa.
# Toque remoto: os dedos de um celular no Moonlight chegam pelo touchscreen
# virtual do Sunshine (regra udev própria, só para esse dispositivo).
# X11 (XTest) e Wayland (zwp_virtual_keyboard_v1, layer-shell).
#
# Para compilar a cópia local do repositório:
#   BIG_KEYBOARD_SOURCE="git+file://$PWD/.." makepkg
pkgname=big-keyboard
pkgver=0.2.4
pkgrel=1
pkgdesc="Big WindowMaker: teclado na tela, digitação pelo controle e controle na tela de toque (X11 e Wayland)"
arch=('x86_64')
url="https://github.com/big-windowmaker/big-keyboard"
license=('GPL-2.0-or-later')
depends=('glibc' 'glib2' 'gtk3' 'at-spi2-core' 'cairo' 'pango' 'libx11' 'libxtst' 'libxkbcommon' 'wayland'
	'gtk-layer-shell' 'systemd-libs' 'hicolor-icon-theme'
	# o ícone só existe em SVG (máscara e sombra): desenhado pelo carregador do librsvg
	'librsvg'
	# os emojis do painel ☺: sem uma fonte de emoji, viram quadrados com o código
	'noto-fonts-emoji')
makedepends=('git' 'meson' 'wayland-protocols')
optdepends=(
	'steam-devices: acesso ao /dev/uinput para o controle virtual (regra uaccess)'
	'game-devices-udev: alternativa ao steam-devices para o /dev/uinput'
	'big-wm-lockscreen: o teclado com controle na tela de bloqueio e o controle na tela por cima do bloqueio (Wayland)'
	'big-wm-session: o dockapp no menu Dockapps e o botão das configurações da tela de bloqueio (big-wm-lock-settings)'
	'xorg-xwayland: o dockapp no Dock do wlmaker (é um dockapp X11, acoplado pelo XWayland)'
	'picom: transparência do controle na tela no X11 (sem compositor, o fundo fica preto)'
	'sunshine: toque remoto do celular pelo Moonlight no controle na tela (2026.1113 ou mais novo)'
)
source=("big-keyboard::${BIG_KEYBOARD_SOURCE:-git+$url.git#tag=v$pkgver}")
sha256sums=('SKIP')

build() {
	arch-meson big-keyboard build
	meson compile -C build
}

check() {
	# test-vpad pula (77) sem acesso ao /dev/uinput, como num chroot de build
	meson test -C build --print-errorlogs
}

package() {
	meson install -C build --destdir "$pkgdir" --no-rebuild
	cd big-keyboard
	install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
	for f in docs/*.md; do
		install -Dm644 "$f" "$pkgdir/usr/share/doc/$pkgname/${f##*/}"
	done
}
